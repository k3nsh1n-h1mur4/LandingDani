---
interface Props {
  title: string;
}

const { title } = Astro.props;

import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="/images/morenalogo.webp" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Stack+Sans+Headline:wght@200..700&display=swap"
      rel="stylesheet"
    />
    <script
      data-goatcounter="https://my-account.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
    <!-- Open Graph tags   -->
    <meta property="og:title" content="Diputado Daniel Castillo" />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content="https://www.virtualdipdanielcastillo.com"
    />
    <meta
      property="og:description"
      content="Página Virtual Diputado Daniel Castillo"
    />
    <meta property="og:site_name" content="Diputado Daniel Castillo" />

    <title>{title}</title>
  </head>
  <body>
    <div class="container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  html {
    font-family: "Josefin Sans", "Stack Sans Headline", sans-serif;
  }
  :root {
    margin: 0;
    width: 100%;
    height: 100vh;
  }

  /*body {
    margin: 0;
    box-sizing: content-box;
    background-image: linear-gradient(white, darkred);
}*/

  .container {
    min-height: 100vh;
    box-sizing: content-box;
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      "head"
      "principal"
      "foot";
  }

  .head {
    grid-area: head;
    background-color: aqua;
  }
  .principal {
    grid-area: principal;
  }
  .foot {
    grid-area: foot;
    background-color: red;
  }
</style>
