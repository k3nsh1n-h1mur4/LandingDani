---
import Layout from "@layouts/Layout.astro";

export function getStaticPaths() {
    return [
        { params: { albums: "gallery" } },
        { params: { albums: "galeria" } },
    ];
}

const { albums } = Astro.params;
---

<div class="container-header">
    <img
        src="/images/dipLogo.png"
        alt="Logo de dani"
        height="100px"
        width="450px"
    />
    <h2>Dip. Gilberto Daniel Castillo García</h2>
    <div class="menu">
        <a href="/">Inicio</a>
        <a href="/albums/galleries">Galería</a>
        <a href="/about">Acerca de</a>
        <a href="/sendMail">Contacto</a>
    </div>
</div>

<style>
    .container-header {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }
    .container-header p {
        color: #6d0c2e;
        font-size: 25px;
    }
    .menu {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: row;
    }
    .menu a {
        display: inline-block;
        padding: 10px;
        text-decoration: none;
        color: #000;
        font-size: 1.5rem;
        border-top: #000 1px solid;
        border-bottom: #000 1px solid;
    }

    .menu a:hover {
        color: red;
    }
</style>
