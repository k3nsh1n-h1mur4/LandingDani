---
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

---
<BaseLayout title="Header">
<header>
  <p>Oficina Virtual
    <br />
    Dip. Gilberto Daniel Castillo García
  </p>
  <img src="/images/morenalogo.webp" alt="Logo de morena">
  <nav>
    <ul>
      <li><a href="/albums/gallery">Galería</a></li>
      <li><a href="/about">Acerca de</a></li>
      <li><a href="#">Contacto</a></li>
    </ul>
  </nav>
</header>
</BaseLayout>




<style>
  header {
    background-color: #6d0c2e;
    display: flex;
    justify-content: space-around;
    align-items: center;
  }
  header img {
    width: 150px;
    height: 150px;
  }

  header p {
    color: lightgray;
    font-size: 1.5rem;
    margin-left: 10px;
  }

  header nav ul {
    display: flex;
    flex-direction: row wrap;
    list-style: none;
  }

  header nav ul li {
    padding: 5px;
    /*background-color: lightgray;*/
  }

  header nav ul li a {
    display: inline-block;
    padding: 10px;
    text-decoration: none;
    color: lightgray;
    font-size: 1.5rem;
  }

