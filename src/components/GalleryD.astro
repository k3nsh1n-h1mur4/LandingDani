---

<div class="container">
    <div class="title">
        <h1>Galeria</h1>
    </div>
    <div class="container-grid">
        {
            pages.map((page) => (
                <a href={`/albums/${page.id}`} class="group transition-all mb-4 block">
                    <Image
                        src={page.data.cover}
                        alt={page.data.title}
                        width={520}
                        min-height={100}
                        quality="mid"
                        class:list={[
                            "rounded-lg transition-all",
                            "group-hover:shadow-lg group-hover:opacity-90",
                        ]}
                    />
                    <div class="mt-4 text-center text-neutral-700">
                        <strong class="font-normal">{page.data.description}</strong>
                    </div>
                </a>
            ))
        }
    </div>
</div>

<style>
    .container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
    }
    .title {
        text-align: center;
    }
    .container-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-gap: 10px;
    }
</style>