---
interface Props {
  title: string,
  image: string,
  gal: string,
}

import BaseLayout from '@layouts/BaseLayout.astro'

const { title, image, gal } = Astro.props;

---

<BaseLayout title='Card'>
  <div class="card">
    <div class="title">
      <a href={gal}>Galeria {title}</a>
    </div>
    <div class="image">
      <img src={image} alt="Daniel">
    </div>
  </div>
</BaseLayout>

<style>
  .card {
    /* border: 1px dashed; */
    border: 1px dashed;
    width: 500px;
  }
  
  .title {
    text-align: center;
    padding: 10px;
    margin-top: 10px;
  }
  .title a {
    text-decoration: none;
    color: red;
    font-size: 20px;
  }

  .image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .image img {
    width: 80%;
    display: block;
    margin: auto 0;
  }
</style>


