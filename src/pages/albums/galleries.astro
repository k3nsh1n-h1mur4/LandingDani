---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card.astro";
import ComisionSalud from "@components/ComisionSalud.astro";
---

<BaseLayout title="Galerías">
  <Header />
  <div class="main">
    <Card title="2025" image="/images/mesa4.jpg" gal="/albums/galeria2025" />
    <Card title="2026" image="/images/19.jpeg" gal="/albums/galeria" />
    <Card
      title="Comisión Salud"
      image="/images/comisionsalud/cs1.jpg"
      gal="/albums/comisionsalud"
    />
    <Card
      title="Comisión Trabajo y Previsión Social"
      image="/images/comisionprevision/cp1.jpg"
      gal="/albums/comisionprevision"
    />
  </div>

  <Footer />
</BaseLayout>

<style>
  .main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .cms img:hover {
    transition: 0.5s ease;
    opacity: 0.3;
  }

  span {
    text-align: center;
    font-size: 25px;
    color: red;
    margin-top: 20px;
  }
</style>
