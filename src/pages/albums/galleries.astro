---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card  from "@components/Card.astro";
---
<BaseLayout title="Galerías">
  <Header />
  <div class="main">
    <Card title="2025" image="/images/mesa4.jpg" gal="galeria2025" />
    <Card title="2026" image="/images/19.jpeg" gal="galeria" />
  </div>
  <Footer />

</BaseLayout>


<style>
  .main {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }
</style>
